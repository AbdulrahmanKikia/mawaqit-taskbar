<Window
    x:Class="Mawaqit.WinUI.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Padding="20">
        <StackPanel Spacing="12" MaxWidth="480">
            <TextBlock Text="Preferences" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="mosqueLabel" Opacity="0.8"/>
            <Button Content="Change mosque…" Click="Mosque_Click"/>

            <TextBlock Text="Countdown" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <RadioButtons x:Name="countdown" Header="Count down to">
                <RadioButton Content="Adhan"/>
                <RadioButton Content="Iqama"/>
                <RadioButton Content="Adhan, then iqama"/>
            </RadioButtons>
            <TextBlock Text="Adhan, then iqama counts to the call, then to iqama for that same prayer, then the next adhan." Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>

            <TextBlock Text="Placement" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <RadioButtons x:Name="hostKind" Header="Where the chip lives">
                <RadioButton Content="In the taskbar (injected chip)"/>
                <RadioButton Content="Screen strip (0.1-style AppBar — reserves desktop space)"/>
            </RadioButtons>
            <TextBlock Text="The strip is a full-width bar above the taskbar. Windows will not cover it. It shows the mosque name and the prayer being tracked — not the whole day's times." Opacity="0.7" FontSize="12" TextWrapping="Wrap"/>

            <TextBlock Text="Chip size" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <RadioButtons x:Name="chipSize" Header="Always-on info">
                <RadioButton Content="Compact — countdown only"/>
                <RadioButton Content="Expanded — prayer, time, countdown (0.1)"/>
            </RadioButtons>
            <CheckBox x:Name="autostart" Content="Start with Windows"/>

            <TextBlock Text="Notifications" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <CheckBox x:Name="nEnable" Content="Enable notifications"/>
            <CheckBox x:Name="nAdhan" Content="At adhan"/>
            <CheckBox x:Name="nIqama" Content="At iqama"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Minutes before adhan" VerticalAlignment="Center"/>
                <NumberBox x:Name="nBefore" Minimum="0" Maximum="60" SpinButtonPlacementMode="Inline" Width="120"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CheckBox x:Name="nFajr" Content="Fajr"/>
                <CheckBox x:Name="nDhuhr" Content="Dhuhr"/>
                <CheckBox x:Name="nAsr" Content="Asr"/>
                <CheckBox x:Name="nMaghrib" Content="Maghrib"/>
                <CheckBox x:Name="nIsha" Content="Isha"/>
            </StackPanel>

            <TextBlock Text="Favorites (max 5)" FontWeight="SemiBold" Margin="0,8,0,0"/>
            <ListView x:Name="favList" Height="120"/>
            <Button Content="Remove selected favorite" Click="RemoveFav_Click"/>

            <TextBlock x:Name="updateStatus" Opacity="0.8" Margin="0,8,0,0"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="Check for updates" Click="Update_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
