<Window
    x:Class="Mawaqit.WinUI.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">
    <Grid x:Name="root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Padding="16,0,140,0">
            <TextBlock x:Name="titleBarTb" Text="Mawaqit" VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"/>
        </Grid>
        <ScrollViewer Grid.Row="1" Padding="24,8,24,28">
            <StackPanel Spacing="4" MaxWidth="720">
                <TextBlock x:Name="pageTitle" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12"/>

                <controls:SettingsCard x:Name="langCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="langBox" MinWidth="200" SelectionChanged="Lang_Changed">
                        <ComboBoxItem/>
                        <ComboBoxItem/>
                        <ComboBoxItem/>
                        <ComboBoxItem/>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard x:Name="mosqueCard">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE707;"/>
                    </controls:SettingsCard.HeaderIcon>
                    <Button x:Name="changeMosqueBtn" Click="Mosque_Click"/>
                </controls:SettingsCard>

                <!-- Where prayer times come from: mosque timetable, or calculated for a place. -->
                <controls:SettingsExpander x:Name="timesExp" IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE823;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Name="timesSourceCard">
                            <ComboBox x:Name="timesSource" MinWidth="280" SelectionChanged="Times_Changed">
                                <ComboBoxItem/>
                                <ComboBoxItem/>
                                <ComboBoxItem/>
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="locationCard">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <ToggleSwitch x:Name="locationAuto" Toggled="TimesToggle_Changed"/>
                                <Button x:Name="pickLocationBtn" Click="PickLocation_Click"/>
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="locationOffCard" Visibility="Collapsed">
                            <HyperlinkButton x:Name="locationSettingsLink" Click="LocationSettings_Click"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="methodCard">
                            <ComboBox x:Name="methodBox" MinWidth="280" MaxWidth="340" SelectionChanged="Times_Changed"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="asrCard">
                            <ComboBox x:Name="asrBox" MinWidth="220" SelectionChanged="Times_Changed">
                                <ComboBoxItem/>
                                <ComboBoxItem/>
                                <ComboBoxItem/>
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="highLatCard">
                            <ComboBox x:Name="highLatBox" MinWidth="220" SelectionChanged="Times_Changed">
                                <ComboBoxItem/>
                                <ComboBoxItem/>
                                <ComboBoxItem/>
                            </ComboBox>
                        </controls:SettingsCard>
                        <!-- Only for mosques that are not on Mawaqit: the user types their iqama. -->
                        <controls:SettingsCard x:Name="iqamaCard" Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBox x:Name="iqFajr" Width="76" PlaceholderText="+20"/>
                                    <TextBox x:Name="iqDhuhr" Width="76" PlaceholderText="13:30"/>
                                    <TextBox x:Name="iqAsr" Width="76" PlaceholderText="+10"/>
                                    <TextBox x:Name="iqMaghrib" Width="76" PlaceholderText="+5"/>
                                    <TextBox x:Name="iqIsha" Width="76" PlaceholderText="+10"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button x:Name="saveIqamaBtn" Click="SaveIqama_Click" Style="{StaticResource AccentButtonStyle}"/>
                                    <HyperlinkButton x:Name="websiteLink" Click="Website_Click" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander x:Name="countdownExp">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE916;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Name="countdownToCard">
                            <RadioButtons x:Name="countdown" MaxColumns="1" SelectionChanged="Any_Changed">
                                <RadioButton x:Name="cdAdhan"/>
                                <RadioButton x:Name="cdIqama"/>
                                <RadioButton x:Name="cdBoth"/>
                            </RadioButtons>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="countdownHint"/>
                        <controls:SettingsCard x:Name="menuCountdownCard">
                            <ToggleSwitch x:Name="menuCountdown" Toggled="Any_Changed"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander x:Name="placeExp">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8A7;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Name="placeCard">
                            <RadioButtons x:Name="hostKind" MaxColumns="1" SelectionChanged="Any_Changed">
                                <RadioButton x:Name="hostInject"/>
                                <RadioButton x:Name="hostStrip"/>
                            </RadioButtons>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="placeHint"/>
                        <controls:SettingsCard x:Name="menuPlacementCard">
                            <ToggleSwitch x:Name="menuPlacement" Toggled="Any_Changed"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander x:Name="chipExp">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8A5;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Name="sizeCard">
                            <RadioButtons x:Name="chipSize" MaxColumns="1" SelectionChanged="Any_Changed">
                                <RadioButton x:Name="sizeCompact"/>
                                <RadioButton x:Name="sizeExpanded"/>
                            </RadioButtons>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="menuChipSizeCard">
                            <ToggleSwitch x:Name="menuChipSize" Toggled="Any_Changed"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="autostartCard">
                            <ToggleSwitch x:Name="autostart" Toggled="Any_Changed"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander x:Name="notifExp">
                    <ToggleSwitch x:Name="nEnable" Toggled="Any_Changed"/>
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xEA8F;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Name="nAdhanCard">
                            <ToggleSwitch x:Name="nAdhan" Toggled="Any_Changed"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="nIqamaCard">
                            <ToggleSwitch x:Name="nIqama" Toggled="Any_Changed"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="nBeforeCard">
                            <NumberBox x:Name="nBefore" Minimum="0" Maximum="60"
                                       SpinButtonPlacementMode="Inline" Width="120"
                                       ValueChanged="Number_Changed"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="nFajrCard">
                            <ToggleSwitch x:Name="nFajr" Toggled="Any_Changed"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="nDhuhrCard">
                            <ToggleSwitch x:Name="nDhuhr" Toggled="Any_Changed"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="nAsrCard">
                            <ToggleSwitch x:Name="nAsr" Toggled="Any_Changed"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="nMaghribCard">
                            <ToggleSwitch x:Name="nMaghrib" Toggled="Any_Changed"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Name="nIshaCard">
                            <ToggleSwitch x:Name="nIsha" Toggled="Any_Changed"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander x:Name="favExp">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE734;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard>
                            <ListView x:Name="favList" MinHeight="80" MaxHeight="160" Width="360"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard>
                            <Button x:Name="removeFavBtn" Click="RemoveFav_Click"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander x:Name="aboutExp">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE946;"/>
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Name="aboutCard">
                            <Button x:Name="updateBtn" Click="Update_Click"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard>
                            <TextBlock x:Name="updateStatus" Opacity="0.8" TextWrapping="Wrap"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
