<UserControl
    x:Class="Mawaqit.WinUI.Views.WidgetPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="10" MinWidth="264" MaxWidth="290" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hero: next prayer, countdown, progress since the previous prayer. -->
        <Border CornerRadius="10" Padding="14,12,14,12" Background="{ThemeResource BrandHeroBrush}">
            <Grid RowSpacing="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="nextLabelTb" FontSize="11" FontWeight="SemiBold" CharacterSpacing="60"
                           Foreground="{ThemeResource BrandHeroHighlightBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" Margin="0,-6,-8,0" VerticalAlignment="Top">
                    <Button x:Name="refreshBtn" Click="Refresh_Click" Style="{StaticResource QuietIconButton}"
                            Foreground="{ThemeResource BrandOnPrimaryBrush}">
                        <FontIcon Glyph="&#xE72C;" FontSize="12"/>
                    </Button>
                    <Button x:Name="settingsBtn" Click="Settings_Click" Style="{StaticResource QuietIconButton}"
                            Foreground="{ThemeResource BrandOnPrimaryBrush}">
                        <FontIcon Glyph="&#xE713;" FontSize="12"/>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="titleTb" Grid.Row="1" Grid.ColumnSpan="2" FontSize="15" FontWeight="SemiBold"
                           Foreground="{ThemeResource BrandOnPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="10">
                    <TextBlock x:Name="countdownTb" FontSize="30" FontWeight="SemiBold"
                               Foreground="{ThemeResource BrandOnPrimaryBrush}"/>
                    <TextBlock x:Name="atTb" FontSize="13" VerticalAlignment="Bottom" Margin="0,0,0,6"
                               Foreground="{ThemeResource BrandHeroHighlightBrush}"/>
                </StackPanel>
                <Grid x:Name="progressTrack" Grid.Row="3" Grid.ColumnSpan="2" Height="4" Margin="0,8,0,0" CornerRadius="2"
                      Background="{ThemeResource BrandTrackBrush}">
                    <Border x:Name="progressFill" HorizontalAlignment="Left" CornerRadius="2"
                            Background="{ThemeResource BrandHeroHighlightBrush}" Width="0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Where the times come from. -->
        <StackPanel Grid.Row="1" Spacing="1" Padding="4,0">
            <TextBlock x:Name="mosqueTb" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="sourceTb" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>
            <TextBlock x:Name="freshnessTb" FontSize="11" TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
        </StackPanel>

        <!-- Today. -->
        <StackPanel Grid.Row="2" Spacing="2">
            <Grid ColumnSpacing="4" Padding="10,0,10,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="58"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="prayerCol" FontSize="11" Opacity="0.55"/>
                <TextBlock x:Name="adhanCol" Grid.Column="1" FontSize="11" Opacity="0.55" TextAlignment="Right"/>
                <TextBlock x:Name="iqamaCol" Grid.Column="2" FontSize="11" Opacity="0.55" TextAlignment="Right"/>
            </Grid>
            <ItemsControl x:Name="list">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Border CornerRadius="8" Background="{ThemeResource BrandPrimarySoftBrush}"
                                    Visibility="{Binding IsNext, Converter={StaticResource BoolToVis}}"/>
                            <Border Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="3,0,0,0"
                                    Background="{ThemeResource BrandHighlightBrush}"
                                    Visibility="{Binding IsNext, Converter={StaticResource BoolToVis}}"/>
                            <Grid ColumnSpacing="4" Padding="10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="58"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Adhan}" FontSize="13" VerticalAlignment="Center"
                                           TextAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="{Binding Iqama}" FontSize="13" Opacity="0.65"
                                           VerticalAlignment="Center" TextAlignment="Right"/>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Footer actions. -->
        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="qiblaBtn" Click="Qibla_Click" HorizontalAlignment="Stretch" CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE842;" FontSize="13" Foreground="{ThemeResource BrandPrimaryBrush}"/>
                    <TextBlock x:Name="qiblaBtnTb" FontSize="12"/>
                </StackPanel>
            </Button>
            <Button x:Name="mosqueLink" Grid.Column="1" Click="Mosque_Click" HorizontalAlignment="Stretch" CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE707;" FontSize="13" Foreground="{ThemeResource BrandPrimaryBrush}"/>
                    <TextBlock x:Name="mosqueBtnTb" FontSize="12" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
