<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Pure, unit-tested logic shared by the WinUI host: Mawaqit data parsing, schedule,
    alerts, config, storage, Qibla. No UI or Windows Runtime references allowed here
    (enforced by tests/Mawaqit.Tests/Architecture/RulesTests.cs).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Mawaqit.Core</RootNamespace>
    <AssemblyName>Mawaqit.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="0.17.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Mawaqit.Tests" />
  </ItemGroup>
</Project>
